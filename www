
<!DOCTYPE html>
<html lang="ru">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>RESALE GEARE — Магазин одежды</title>
<meta name="description" content="RESALE GEARE — магазин стильной одежды в стиле streetwear и casual. Найди свой образ.">
<style>
*{box-sizing:border-box;margin:0;padding:0}
body{font-family:Arial,sans-serif;background:#f6f5f2;color:#171717}
header{background:#111;color:white;padding:20px 5%;display:flex;justify-content:space-between;align-items:center;gap:12px;flex-wrap:wrap}
.logo{font-size:23px;font-weight:900;letter-spacing:2px}
.cart-btn{background:#fff;color:#111;border:0;padding:12px 16px;border-radius:8px;font-weight:bold;cursor:pointer}
.hero{padding:55px 6%;background:#dedbd4}
.hero p{font-size:12px;letter-spacing:3px;margin-bottom:15px}
.hero h1{font-size:clamp(38px,8vw,72px);line-height:1.02;max-width:650px}
.hero h1 span{color:#777}
.hero .desc{font-size:16px;letter-spacing:0;margin-top:20px;line-height:1.5}
.shop{padding:35px 5%}
.controls{display:flex;gap:10px;flex-wrap:wrap;margin:22px 0}
input,select,button{font:inherit}
.controls input,.controls select{padding:13px;border:1px solid #ccc;border-radius:8px;background:white}
.controls input{flex:1;min-width:160px}
.categories{display:flex;gap:8px;flex-wrap:wrap;margin-bottom:25px}
.categories button{padding:10px 15px;border:1px solid #ddd;border-radius:30px;background:white;cursor:pointer}
.categories button.active{background:#111;color:white}
.products{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:12px}
.card{background:white;border-radius:12px;overflow:hidden}
.photo{height:180px;background:#e5e3df;display:flex;align-items:center;justify-content:center;font-size:65px}
.info{padding:13px}
.tag{font-size:10px;color:#777;letter-spacing:1px}
.info h3{font-size:15px;margin:8px 0}
.price{font-weight:bold;font-size:18px}
.old{color:#888;text-decoration:line-through;font-size:13px;margin-left:6px}
.add{width:100%;margin-top:12px;padding:12px;background:#111;color:white;border:0;border-radius:7px;cursor:pointer}
.add:hover,.cart-btn:hover{opacity:.8}
footer{background:#111;color:#ddd;padding:30px 5%;margin-top:35px;line-height:1.8}
footer strong{color:white}
.modal{display:none;position:fixed;inset:0;background:#0009;z-index:10;padding:15px;align-items:center;justify-content:center}
.modal.show{display:flex}
.panel{background:white;width:100%;max-width:440px;max-height:90vh;overflow:auto;padding:22px;border-radius:14px}
.panel h2{margin-bottom:18px}
.close{float:right;border:0;background:#eee;padding:7px 11px;border-radius:6px;cursor:pointer}
.cart-line{display:flex;justify-content:space-between;gap:12px;padding:12px 0;border-bottom:1px solid #eee}
.field{width:100%;padding:12px;margin:7px 0 12px;border:1px solid #ccc;border-radius:7px}
.checkout{width:100%;padding:14px;background:#111;color:white;border:0;border-radius:8px;margin-top:15px;cursor:pointer}
.note{font-size:12px;color:#666;margin-top:12px;line-height:1.5}
@media(min-width:650px){.products{grid-template-columns:repeat(4,minmax(0,1fr));gap:20px}.photo{height:240px}.hero{padding:85px 8%}}
</style>
</head>
<body>

<header>
  <div class="logo">RESALE GEARE®</div>
  <button class="cart-btn" onclick="openCart()">Корзина (<span id="count">0</span>)</button>
</header>

<section class="hero">
  <p>YOUR STYLE. YOUR RULES.</p>
  <h1>ОДЕЖДА.<br><span>ТВОЙ ХАРАКТЕР.</span></h1>
  <div class="desc">Streetwear и casual вещи для твоего собственного стиля.</div>
</section>

<main class="shop">
  <h2>Каталог одежды</h2>
  <div class="controls">
    <input id="search" type="search" placeholder="Поиск одежды..." oninput="render()">
    <select id="sort" onchange="render()">
      <option value="default">Сначала популярное</option>
      <option value="low">Сначала дешевле</option>
      <option value="high">Сначала дороже</option>
    </select>
  </div>

  <div class="categories" id="categories">
    <button class="active" onclick="setCategory('Все',this)">Все</button>
    <button onclick="setCategory('Футболки',this)">Футболки</button>
    <button onclick="setCategory('Худи',this)">Худи</button>
    <button onclick="setCategory('Штаны',this)">Штаны</button>
    <button onclick="setCategory('Куртки',this)">Куртки</button>
    <button onclick="setCategory('Аксессуары',this)">Аксессуары</button>
  </div>

  <div class="products" id="products"></div>
</main>

<footer>
  <strong>RESALE GEARE®</strong><br>
  Одежда для тех, кто создаёт свой стиль.<br>
  <span id="year"></span> © RESALE GEARE
</footer>

<div class="modal" id="cartModal" onclick="if(event.target===this)closeCart()">
  <div class="panel">
    <button class="close" onclick="closeCart()">Закрыть ✕</button>
    <h2>Твоя корзина</h2>
    <div id="cartItems"></div>
    <h3 style="margin-top:18px">Итого: <span id="total">0</span> ₴</h3>
    <form id="orderForm" onsubmit="placeOrder(event)">
      <label for="customer">Твоё имя</label>
      <input class="field" id="customer" required placeholder="Имя">
      <label for="phone">Телефон для связи</label>
      <input class="field" id="phone" required type="tel" placeholder="+380...">
      <label for="address">Город и отделение доставки</label>
      <input class="field" id="address" required placeholder="Город, отделение">
      <button class="checkout" type="submit">Оформить демо-заказ</button>
    </form>
    <p class="note">Демо-версия: заказ никуда не отправляется, реальная оплата и доставка не подключены.</p>
  </div>
</div>

<script>
const items = [
  {id:1,name:"Oversize футболка",category:"Футболки",price:450,old:600,emoji:"👕"},
  {id:2,name:"Basic белая футболка",category:"Футболки",price:350,old:450,emoji:"👕"},
  {id:3,name:"Street худи",category:"Худи",price:1100,old:1400,emoji:"🧥"},
  {id:4,name:"Classic худи",category:"Худи",price:950,old:1200,emoji:"🧥"},
  {id:5,name:"Cargo штаны",category:"Штаны",price:850,old:1050,emoji:"👖"},
  {id:6,name:"Wide leg джинсы",category:"Штаны",price:1000,old:1300,emoji:"👖"},
  {id:7,name:"Bomber куртка",category:"Куртки",price:1600,old:2000,emoji:"🧥"},
  {id:8,name:"Streetwear кепка",category:"Аксессуары",price:300,old:400,emoji:"🧢"}
];

let category="Все";
let cart={};

function setCategory(value,button){
  category=value;
  document.querySelectorAll(".categories button").forEach(b=>b.classList.remove("active"));
  button.classList.add("active");
  render();
}

function render(){
  let query=document.getElementById("search").value.toLowerCase();
  let sort=document.getElementById("sort").value;
  let list=items.filter(p=>
    (category==="Все"||p.category===category)&&
    p.name.toLowerCase().includes(query)
  );
  if(sort==="low")list.sort((a,b)=>a.price-b.price);
  if(sort==="high")list.sort((a,b)=>b.price-a.price);

  document.getElementById("products").innerHTML=list.length?list.map(p=>`
    <article class="card">
      <div class="photo">${p.emoji}</div>
      <div class="info">
        <div class="tag">${p.category.toUpperCase()}</div>
        <h3>${p.name}</h3>
        <div><span class="price">${p.price} ₴</span><span class="old">${p.old} ₴</span></div>
        <button class="add" onclick="addToCart(${p.id})">В корзину +</button>
      </div>
    </article>
  `).join(""):"<p>Ничего не найдено. Попробуй другой запрос.</p>";
}

function addToCart(id){
  cart[id]=(cart[id]||0)+1;
  updateCart();
}

function updateCart(){
  let count=Object.values(cart).reduce((a,b)=>a+b,0);
  let total=items.reduce((sum,p)=>sum+p.price*(cart[p.id]||0),0);
  document.getElementById("count").textContent=count;
  document.getElementById("total").textContent=total;
  let lines=items.filter(p=>cart[p.id]).map(p=>`
    <div class="cart-line">
      <div>${p.name}<br><b>${p.price} ₴</b> × ${cart[p.id]}</div>
      <div>
        <button onclick="changeQty(${p.id},-1)">−</button>
        <button onclick="changeQty(${p.id},1)">+</button>
      </div>
    </div>
  `).join("");
  document.getElementById("cartItems").innerHTML=lines||"<p>Корзина пока пустая.</p>";
}

function changeQty(id,delta){
  cart[id]=(cart[id]||0)+delta;
  if(cart[id]<=0)delete cart[id];
  updateCart();
}

function openCart(){
  document.getElementById("cartModal").classList.add("show");
  updateCart();
}
function closeCart(){
  document.getElementById("cartModal").classList.remove("show");
}

function placeOrder(event){
  event.preventDefault();
  if(Object.keys(cart).length===0){
    alert("Сначала добавь товары в корзину.");
    return;
  }
  alert("Это демо-магазин. Заказ не отправлен продавцу. Для реальных заказов нужно подключить форму или сервер.");
}

document.getElementById("year").textContent=new Date().getFullYear();
render();
updateCart();
</script>
</body>
</html>
